generator client {
  provider = "prisma-client"
  output   = "../src/config/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum Permission {
  MANAGE_USERS
  MANAGE_ROLES
  VIEW_PATIENTS
  EDIT_PATIENTS
  VIEW_APPOINTMENTS
  EDIT_APPOINTMENTS
  VIEW_DASHBOARD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  role         Role
  permissions  Permission[] 

  appointments Appointment[] @relation("DoctorAppointments")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Patient {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  email        String? @unique
  phone        String?
  birthDate    DateTime?
  gender       Gender?
  address      String?
  notes        String?

  appointments Appointment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id          String  @id @default(cuid())
  date        DateTime
  reason      String?
  notes       String?
  status      AppointmentStatus @default(SCHEDULED)

  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])

  doctorId    String
  doctor      User @relation("DoctorAppointments", fields: [doctorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt  
}